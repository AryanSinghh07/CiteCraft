# Copy this file to .env.local and fill in the values.
# Leave the Supabase values empty to run in demo mode (data stays in your browser).

# Supabase -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: document summarization service (POST /upload with a "document" file field)
VITE_SUMMARY_API_URL=
