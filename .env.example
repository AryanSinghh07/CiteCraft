# Copy this file to .env.local and fill in the values.
# Leave the Supabase values empty to run in demo mode (data stays in your browser).

# Supabase -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Contact email shown on the privacy policy (for account recovery and data requests)
VITE_CONTACT_EMAIL=

# AI features use Supabase Edge Functions; their secrets (ANTHROPIC_API_KEY) are set in Supabase, never here.
